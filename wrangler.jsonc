{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boss-mode",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/analytics*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  // Per-IP limits. A classroom or household shares one address, so the event limit leaves room for ~30 players at once.
  // Namespace ids only need to be unique within the Cloudflare account.
  "ratelimits": [
    { "name": "EVENT_LIMITER", "namespace_id": "81530101", "simple": { "limit": 600, "period": 60 } },
    { "name": "BOARD_LIMITER", "namespace_id": "81530102", "simple": { "limit": 30, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "81530103", "simple": { "limit": 120, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "81530104", "simple": { "limit": 6, "period": 60 } }
  ],
  "observability": { "enabled": true },
  // Same Cloudflare account and domain as Footy Draft (footydraft.mac-tbo.com).
  "account_id": "f22a506dedde3bb3837157cd47d5fe5c",
  "routes": [{ "pattern": "bossmode.mac-tbo.com", "custom_domain": true }]
}
